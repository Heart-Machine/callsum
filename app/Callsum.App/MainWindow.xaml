<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Callsum.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Callsum.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!-- Состояние связи с OBS: видно сразу, без раскрытия журнала. -->
            <TextBlock
                x:Name="ObsStatus"
                VerticalAlignment="Center"
                Text="OBS: подключаюсь…"
                Opacity="0.6" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <!-- Появляется, только когда обновление уже скачано: предлагать
                     перезапуск до этого — обманывать ожидание. -->
                <HyperlinkButton
                    x:Name="UpdateReady"
                    Padding="4,0"
                    Visibility="Collapsed"
                    Click="OnUpdateClick" />

                <!-- Появляется, когда в OBS нет профиля и коллекции callsum:
                     без них запись пойдёт с чужими настройками. -->
                <HyperlinkButton
                    x:Name="SetUpObs"
                    Padding="4,0"
                    Visibility="Collapsed"
                    Content="Настроить OBS"
                    Click="OnSetUpObsClick" />

                <HyperlinkButton
                    x:Name="OpenSettings"
                    Padding="4,0"
                    Content="Настройки"
                    Click="OnSettingsClick" />
            </StackPanel>
        </Grid>

        <Button
            x:Name="RecordButton"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Height="56"
            FontSize="17"
            FontWeight="SemiBold"
            IsEnabled="False"
            Content="● Начать запись"
            Click="OnRecordClick" />

        <TextBlock
            x:Name="Timer"
            Grid.Row="2"
            HorizontalAlignment="Center"
            FontSize="30"
            FontFamily="Consolas"
            Text="00:00:00" />

        <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock
                x:Name="Stage"
                HorizontalAlignment="Center"
                Text="Готов к записи" />

            <!-- Полоса прячется, когда обработки нет: пустая шкала сбивает с толку. -->
            <ProgressBar
                x:Name="Progress"
                Visibility="Collapsed"
                Minimum="0"
                Maximum="1" />
        </StackPanel>

        <!-- Готовые записи: главное, ради чего открывают окно после созвона. -->
        <Grid Grid.Row="4" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Последние записи" FontWeight="SemiBold" />
                <HyperlinkButton
                    x:Name="OpenOutFolder"
                    HorizontalAlignment="Right"
                    Padding="4,0"
                    Content="Открыть папку"
                    IsEnabled="False"
                    Click="OnOpenOutFolderClick" />
            </Grid>

            <Border
                Grid.Row="1"
                BorderThickness="1"
                CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <ListView
                        x:Name="Results"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnResultClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ResultRow">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Note}"
                                            Opacity="0.6"
                                            FontSize="12" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                        <!-- Пересобрать протокол: после сбоя обработки
                                             и когда поменялся шаблон протокола. -->
                                        <Button
                                            Content="Заново"
                                            Tag="{x:Bind}"
                                            Click="OnReprocessClick" />
                                        <Button
                                            Content="Папка"
                                            Tag="{x:Bind Folder}"
                                            Click="OnOpenFolderClick" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Пустой список без объяснения выглядит поломкой. -->
                    <TextBlock
                        x:Name="ResultsHint"
                        Margin="12"
                        Opacity="0.6"
                        TextWrapping="Wrap"
                        Text="Здесь появятся обработанные записи." />
                </Grid>
            </Border>
        </Grid>

        <!-- Журнал нужен, когда что-то пошло не так, поэтому свёрнут. -->
        <Expander
            x:Name="LogExpander"
            Grid.Row="5"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="Журнал">
            <ScrollViewer x:Name="LogScroll" MaxHeight="220">
                <TextBlock
                    x:Name="Log"
                    FontFamily="Consolas"
                    FontSize="12"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Expander>

        <TextBlock
            Grid.Row="6"
            Opacity="0.6"
            FontSize="12"
            Text="Запись ведёт OBS: приложение переключает его на свой профиль и возвращает прежний после остановки." />
    </Grid>
</Window>
