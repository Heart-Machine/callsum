<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Callsum.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <!-- Без MSIX: приложение ставится в профиль пользователя обычным установщиком. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Приложение несёт Windows App SDK с собой: коллеге не нужно ставить
         среду выполнения и просить для этого администратора. Неупакованное
         приложение без этого просто не запускается. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\callsum-icon.ico</ApplicationIcon>
    <!-- Точка входа своя (Program.cs): Velopack должен отработать служебные
         ключи установки и обновления раньше, чем появится окно. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Версия одна на всё приложение: её же берёт установщик. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Callsum.Obs\Callsum.Obs.csproj" />
    <ProjectReference Include="..\Callsum.Core\Callsum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\callsum-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\callsum-icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
